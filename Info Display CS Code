        #region Account HUD & Risk Management Methods

        private sealed record DisplayLine(string Label, string Value, decimal? RawForColoring, bool IsStatPair = false, decimal? RawForColoringRight = null);

        private List<DisplayLine> BuildLines(Portfolio p, decimal currentVolume)
        {
            var lines = new List<DisplayLine>();

            string displayAccount = p.AccountID;
            if (ObfuscateAccountId && !string.IsNullOrEmpty(displayAccount) && displayAccount.Length > 5)
            {
                displayAccount = $"{displayAccount.Substring(0, 4)}***{displayAccount.Substring(displayAccount.Length - 1, 1)}";
            }

            decimal netClosedPnL = p.ClosedPnL;
            decimal netTotalPnL = p.ClosedPnL + p.OpenPnL;

            if (DeductCommissions)
            {
                decimal activeCommission = p.Commission;
                if (UseManualCommission && activeCommission == 0m)
                {
                    activeCommission = (decimal)ManualCommissionPerContract;
                }

                netClosedPnL -= activeCommission;
                netTotalPnL -= activeCommission;
            }

            // --- STATE TRACKING & PRIORITY AUDIO ALERTS ---
            if (_lastAccountId != p.AccountID)
            {
                _lastAccountId = p.AccountID;
                _peakClosedPnL = netClosedPnL;
                _lastNetClosedPnL = netClosedPnL;
                _dllHit = false;
                _targetHit = false;
                _lastPositionVolume = currentVolume;
                _isFirstLoad = false;
            }
            else
            {
                _peakClosedPnL = Math.Max(_peakClosedPnL, netClosedPnL);

                if (!_isFirstLoad && EnableAudioAlerts)
                {
                    if (currentVolume > _lastPositionVolume)
                    {
                        PlayAlert(AudioPositionEntered, "Position Entered / Added");
                    }

                    if (netClosedPnL != _lastNetClosedPnL)
                    {
                        bool justReachedTarget = !_targetHit && netClosedPnL >= ProfitTarget;

                        decimal activeFailureBuffer = DailyLossLimit + netClosedPnL;
                        if (EnableTrailing)
                        {
                            decimal trailingBarrier = _peakClosedPnL - TrailingDrawdown;
                            decimal trailingBuffer = netClosedPnL - trailingBarrier;
                            if (trailingBuffer < activeFailureBuffer)
                            {
                                activeFailureBuffer = trailingBuffer;
                            }
                        }
                        bool justHitDll = !_dllHit && activeFailureBuffer <= 0;

                        if (justReachedTarget)
                        {
                            PlayAlert(AudioTargetHit, "Daily Profit Target Reached!");
                            _targetHit = true;
                        }
                        else if (justHitDll)
                        {
                            PlayAlert(AudioDllHit, "Daily Loss Limit Hit!");
                            _dllHit = true;
                        }
                        else
                        {
                            if (netClosedPnL > _lastNetClosedPnL)
                                PlayAlert(AudioTradeWin, "Trade Win");
                            else if (netClosedPnL < _lastNetClosedPnL)
                                PlayAlert(AudioTradeLoss, "Trade Loss");
                        }

                        _lastNetClosedPnL = netClosedPnL;
                    }
                }
            }

            _lastPositionVolume = currentVolume;
            _isFirstLoad = false;

            // --- HUD RENDERING ---
            if (ShowAccountId)
                lines.Add(new("Account", displayAccount, null));

            if (ShowCurrency && p.Currency.HasValue)
                lines.Add(new("Currency", p.Currency.Value.ToString(), null));

            if (ShowBalance)
                lines.Add(new("Balance", FormatCurrency(p.Balance), null));

            if (ShowAvailableBalance && p.BalanceAvailable.HasValue)
                lines.Add(new("Available", FormatCurrency(p.BalanceAvailable.Value), null));

            if (ShowMargin)
                lines.Add(new("Blocked Margin", FormatCurrency(p.BlockedMargin), null));

            if (ShowLeverage && p.Leverage != 1)
                lines.Add(new("Leverage", $"{p.Leverage:F2}x", null));

            if (ShowOpenPnL)
                lines.Add(new("Open PnL", FormatCurrency(p.OpenPnL), p.OpenPnL));

            if (ShowClosedPnL)
                lines.Add(new("Closed PnL", FormatCurrency(netClosedPnL), netClosedPnL));

            if (ShowTotalPnL)
                lines.Add(new("Total PnL", FormatCurrency(netTotalPnL), netTotalPnL));

            if (ShowBufferRoom)
            {
                decimal dllBuffer = DailyLossLimit + netClosedPnL;
                decimal activeBuffer = dllBuffer;
                string bufferLabel = "Buffer Left (DLL)";

                if (EnableTrailing)
                {
                    decimal trailingBarrier = _peakClosedPnL - TrailingDrawdown;
                    decimal trailingBuffer = netClosedPnL - trailingBarrier;

                    if (trailingBuffer < dllBuffer)
                    {
                        activeBuffer = trailingBuffer;
                        bufferLabel = "Buffer Left (Trail)";
                    }
                }

                lines.Add(new(bufferLabel, FormatCurrency(activeBuffer), null));
            }

            if (ShowActivePosition && p.OpenPnL != 0m)
            {
                lines.Add(new("----------------", "---------", null));
                lines.Add(new($"[ACTIVE TRADE] {displayAccount}", FormatCurrency(p.OpenPnL), p.OpenPnL));
            }

            // --- TODAY'S STATS (Separated and Evenly Distributed 2-Column Format) ---
            if (ShowTodaysStats && _trades.Any())
            {
                var today = DateTime.Today;
                var todaysTrades = _trades.Where(t => t.CloseTime.Date == today).ToList();

                if (todaysTrades.Any())
                {
                    int totalTrades = todaysTrades.Count;
                    int wins = todaysTrades.Count(t => t.PnL > 0);
                    int losses = todaysTrades.Count(t => t.PnL < 0);

                    decimal winRate = totalTrades > 0 ? (decimal)wins / totalTrades : 0m;
                    decimal lossRate = totalTrades > 0 ? (decimal)losses / totalTrades : 0m;

                    var winningTrades = todaysTrades.Where(t => t.PnL > 0).ToList();
                    var losingTrades = todaysTrades.Where(t => t.PnL < 0).ToList();

                    decimal avgWin = winningTrades.Any() ? winningTrades.Average(t => t.PnL) : 0m;
                    decimal avgLoss = losingTrades.Any() ? Math.Abs(losingTrades.Average(t => t.PnL)) : 0m;

                    decimal winLossRatio = avgLoss > 0 ? avgWin / avgLoss : (avgWin > 0 ? 1m : 0m);
                    decimal performance = winRate * winLossRatio;

                    decimal grossProfit = winningTrades.Sum(t => t.PnL);
                    decimal grossLoss = Math.Abs(losingTrades.Sum(t => t.PnL));
                    decimal profitFactor = grossLoss > 0 ? grossProfit / grossLoss : (grossProfit > 0 ? 99.99m : 0m);

                    decimal bestTrade = todaysTrades.Max(t => t.PnL);
                    decimal worstTrade = todaysTrades.Min(t => t.PnL);
                    decimal ev = (winRate * avgWin) - (lossRate * avgLoss);

                    // Collect active stats into individual entries so they can be paired evenly 2-by-2 across columns
                    var activeStats = new List<(string Text, decimal? RawColor)>();

                    if (StatShowTrades)
                        activeStats.Add(($"Trades: {totalTrades}", null));

                    if (StatShowWins)
                        activeStats.Add(($"Wins: {wins}", null));                    

                    if (StatShowPerformance)
                        activeStats.Add(($"Edge: {performance:0.02}", performance >= 0.5m ? 1m : -1m));

                    if (StatShowEV)
                        activeStats.Add(($"EV: {FormatCurrency(ev)}", ev));

                    if (StatShowProfitFactor)
                        activeStats.Add(($"Profit Factor: {profitFactor:0.02}", profitFactor));

                    if (StatShowWinRate)
                        activeStats.Add(($"Win rate: {winRate * 100:0}%", null));

                    if (StatShowAvgWin)
                        activeStats.Add(($"Avg Win: {FormatCurrency(avgWin)}", null));

                    if (StatShowAvgLoss)
                        activeStats.Add(($"Avg Loss: {FormatCurrency(avgLoss)}", null));

                    if (StatShowBestTrade)
                        activeStats.Add(($"Best: {FormatCurrency(bestTrade)}", null));

                    if (StatShowWorstTrade)
                        activeStats.Add(($"Worst: {FormatCurrency(worstTrade)}", null));

                    if (activeStats.Any())
                    {
                        lines.Add(new("----------------", "---------", null));

                        // Distribute evenly across 2 columns with independent coloring for both sides
                        for (int i = 0; i < activeStats.Count; i += 2)
                        {
                            string col1 = activeStats[i].Text;
                            decimal? raw1 = activeStats[i].RawColor;

                            string col2 = "";
                            decimal? raw2 = null;

                            if (i + 1 < activeStats.Count)
                            {
                                col2 = activeStats[i + 1].Text;
                                raw2 = activeStats[i + 1].RawColor;
                            }

                            lines.Add(new DisplayLine(col1, col2, raw1, true, raw2));
                        }
                    }
                }
            }

            return lines;
        }

        private void PlayAlert(string soundFile, string message)
        {
            if (string.IsNullOrWhiteSpace(soundFile)) return;

            try
            {
                AddAlert(soundFile, InstrumentInfo.Instrument, message, _backgroundColor, _textColor);
            }
            catch
            {
                // Suppress exceptions
            }
        }

        private Color ColorFor(decimal? raw)
            => raw is null ? _textColor
             : raw > 0m ? _positiveColor
             : raw < 0m ? _negativeColor
                        : _neutralColor;

        private void DrawColoredText(RenderContext context, List<DisplayLine> lines,
    Rectangle textRect, int maxLabelWidth)
        {
            var lineHeight = (int)context.MeasureString("A", _font).Height;
            var valueColumnX = textRect.X + maxLabelWidth + ColumnSpacing;
            var currentY = textRect.Y;

            foreach (var line in lines)
            {
                if (line.IsStatPair)
                {
                    // Stat rows: Color both the left and right items independently based on their own rules
                    context.DrawString(line.Label, _font, ColorFor(line.RawForColoring), textRect.X, currentY);
                    context.DrawString(line.Value, _font, ColorFor(line.RawForColoringRight), valueColumnX, currentY);
                }
                else
                {
                    // Standard HUD rows (Account, Balance, PnL): Static label on left, colored value on right
                    context.DrawString(line.Label, _font, _textColor, textRect.X, currentY);
                    context.DrawString(line.Value, _font, ColorFor(line.RawForColoring), valueColumnX, currentY);
                }
                currentY += lineHeight;
            }
        }

        private string FormatCurrency(decimal value) => value.ToString("N2");

        private int CalculateXPosition(int width) => HorizontalPosition switch
        {
            HorizontalAlignment.Left => OffsetX,
            HorizontalAlignment.Center => (Container.Region.Width - width) / 2,
            HorizontalAlignment.Right => Container.Region.Width - width - OffsetX,
            _ => OffsetX
        };

        private int CalculateYPosition(int height) => VerticalPosition switch
        {
            VerticalAlignment.Top => OffsetY,
            VerticalAlignment.Middle => (Container.Region.Height - height) / 2,
            VerticalAlignment.Bottom => Container.Region.Height - height - OffsetY,
            _ => OffsetY
        };

