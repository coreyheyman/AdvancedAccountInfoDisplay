        protected override void OnRender(RenderContext context, DrawingLayouts layout)
        {
            if (ChartInfo == null || Container == null)
                return;

            DrawTrades(context);

            var portfolio = TradingManager?.Portfolio;
            if (portfolio == null)
                return;

            var position = TradingManager?.Position;
            decimal currentVolume = position == null ? 0m : Math.Abs(position.Volume);

            var lines = BuildLines(portfolio, currentVolume);
            if (lines.Count == 0)
                return;

            var lineHeight = (int)context.MeasureString("A", _font).Height;

            var maxLabelWidth = 0;
            var maxValueWidth = 0;

            foreach (var line in lines)
            {
                var labelWidth = (int)context.MeasureString(line.Label, _font).Width;
                var valueWidth = (int)context.MeasureString(line.Value, _font).Width;

                if (labelWidth > maxLabelWidth)
                    maxLabelWidth = labelWidth;
                if (valueWidth > maxValueWidth)
                    maxValueWidth = valueWidth;
            }

            var rectWidth = maxLabelWidth + ColumnSpacing + maxValueWidth + Padding * 2; // ensures slider has enough width
            int sliderExtraHeight = (ShowPnlSlider) ? 45 : 0;
            var rectHeight = (lines.Count * lineHeight) + 20 + (Padding * 2);

            var x = CalculateXPosition(rectWidth);
            var y = CalculateYPosition(rectHeight);

            var rectangle = new Rectangle(x, y, rectWidth, rectHeight);
            context.FillRectangle(_backgroundColor, rectangle);

            // Draw text
            var textRect = new Rectangle(x + Padding, y + Padding, rectWidth - Padding * 2, rectHeight - Padding * 2);
            DrawColoredText(context, lines, textRect, maxLabelWidth);

            // Draw Visual PnL Slider if enabled
            if (ShowPnlSlider)
            {
                DrawPnlSlider(context, textRect, portfolio.ClosedPnL, DailyLossLimit, ProfitTarget);
            }
        }

