#region Trade Visualization Methods
        private void DrawPnlSlider(RenderContext context, Rectangle textRect, decimal currentPnL, int dllLimit, int targetLimit)
        {
            int sliderWidth = textRect.Width;
            int sliderHeight = 10;
            int sliderX = textRect.X;
            int sliderY = textRect.Y + textRect.Height - 12; // Adjusted buffer spacing

            // If ProfitTarget is 0 or negative, treat it as an open-ended profit mode
            bool hasTarget = targetLimit > 0;

            decimal minVal = -dllLimit;
            decimal maxVal = hasTarget ? targetLimit : 0m; // Pushes the 0 marker to the far right edge

            decimal clampedPnL = Math.Max(minVal, Math.Min(maxVal, currentPnL));

            float totalSpan = (float)(maxVal - minVal);
            float currentProgress = (float)(clampedPnL - minVal) / totalSpan;

            // 1. Draw Background Bar Track
            var trackRect = new Rectangle(sliderX, sliderY + 4, sliderWidth, sliderHeight - 4);
            context.FillRectangle(Color.FromArgb(50, 50, 60), trackRect);

            // 2. Draw Negative Zone (Red tint up to zero point)
            decimal zeroProgress = (0m - minVal) / (decimal)totalSpan;
            int zeroX = sliderX + (int)(sliderWidth * (float)zeroProgress);

            if (zeroX > sliderX)
            {
                var redZone = new Rectangle(sliderX, sliderY + 4, zeroX - sliderX, sliderHeight - 4);
                context.FillRectangle(Color.FromArgb(120, 40, 40), redZone);
            }

            // 3. Draw Positive Zone (Green tint) - ONLY if target exists
            if (hasTarget && sliderX + sliderWidth > zeroX)
            {
                var greenZone = new Rectangle(zeroX, sliderY + 4, (sliderX + sliderWidth) - zeroX, sliderHeight - 4);
                context.FillRectangle(Color.FromArgb(30, 100, 50), greenZone);
            }

            // 4. Draw Zero Marker Line
            var linePen = new RenderPen(Color.FromArgb(180, 180, 180), 2);
            context.DrawLine(linePen, zeroX, sliderY, zeroX, sliderY + sliderHeight);

            // 5. Draw Current PnL Handle
            int handleX = sliderX + (int)(sliderWidth * currentProgress);
            int handleWidth = 4;
            var handleRect = new Rectangle(handleX - (handleWidth / 2), sliderY - 1, handleWidth, sliderHeight + 4);

            context.FillRectangle(Color.White, handleRect);
            context.DrawRectangle(new RenderPen(Color.Black, 1), handleRect);
        }

